# ============================================================
# FaceHR - Frontend Environment Variables
# Copy this file to `.env` (client/.env) and fill in.
# Only variables prefixed with VITE_ are exposed to the browser.
# NEVER put backend secrets (Mongo URI, JWT secret, admin password) here.
# ============================================================

# Base URL of the backend API.
#   Local dev : /api   (the Vite dev server proxies /api -> http://localhost:5000)
#   Production: the full Render API base, e.g.
#               VITE_API_BASE_URL=https://facehr-api.onrender.com/api
VITE_API_BASE_URL=https://nuvoxhr.onrender.com/api

# Public base used to resolve uploaded files (employee photos, face images,
# documents). Use the Render backend ORIGIN with NO trailing slash and NO /api:
#   VITE_UPLOAD_BASE_URL=https://facehr-api.onrender.com
# If left empty it is derived automatically from VITE_API_BASE_URL's origin.
VITE_UPLOAD_BASE_URL=https://nuvoxhr.onrender.com