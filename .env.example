# ============================================================
# FaceHR - Backend Environment Variables
# Copy this file to `.env` in the `server/` folder and fill in.
# NEVER commit real secrets.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB (MongoDB Atlas connection string recommended in production)
MONGODB_URI=mongodb://127.0.0.1:27017/facehr

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Allowed frontend origin for CORS (comma separated for multiple)
CLIENT_URL=http://localhost:5173

# Public base URL used when building absolute URLs to uploaded assets
UPLOAD_BASE_URL=http://localhost:5000

# Face recognition matching threshold (Euclidean distance, lower = stricter)
FACE_MATCH_THRESHOLD=0.6

# Face-api model directory (relative to server/ folder)
FACE_MODELS_PATH=face-models

# Office start time used to compute "Late" status (24h format)
OFFICE_START_TIME=09:30

# Working hours below which a day counts as "Half Day"
HALF_DAY_THRESHOLD_HOURS=4

# Seed a default admin from env on first start (optional)
ADMIN_EMAIL=admin@facehr.com
ADMIN_NAME=Super Admin
ADMIN_PASSWORD=Admin@123

# ============================================================
# Frontend Environment Variables (.env in client/) 
# ============================================================
# VITE_API_BASE_URL=/api            (default; use full URL if not proxied)