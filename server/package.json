{
  "name": "facehr-server",
  "version": "1.0.0",
  "private": true,
  "description": "FaceHR backend API - HR management with face-based attendance",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/deploy-migrations.js",
    "db:deploy:neon": "node scripts/apply-schema-neon.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pg-dev.ps1 start",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pg-dev.ps1 stop",
    "db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pg-dev.ps1 status",
    "models:download": "node scripts/download-face-models.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.10",
    "prisma": "^6.19.3",
    "ws": "^8.22.2"
  },
  "optionalDependencies": {
    "@tensorflow/tfjs-node": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
