{
  "name": "facehr",
  "version": "1.0.0",
  "private": true,
  "description": "FaceHR - Smart HR Management with Face-Based Attendance (PERN)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "predev": "node scripts/dev-clean.js",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:clean": "node scripts/dev-clean.js",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "install:all": "npm install --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}